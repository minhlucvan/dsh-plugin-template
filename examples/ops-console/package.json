{
  "name": "@minhlucvan/dsh-plugin-ops-console",
  "version": "0.0.1",
  "private": true,
  "description": "Deep-customization example: a DSH plugin console with tools, policy guards, commands, skills, a Fastify surface, and a zustand React face",
  "license": "BSD-3-Clause",
  "type": "module",
  "imports": {
    "#src/*.tsx": "./src/*.tsx",
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./commands": {
      "types": "./lib/commands.d.ts",
      "default": "./lib/commands.js"
    },
    "./policy": {
      "types": "./lib/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./routes": {
      "types": "./lib/routes.d.ts",
      "default": "./lib/routes.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "default": "./lib/server.js"
    },
    "./skills": {
      "types": "./lib/skills.d.ts",
      "default": "./lib/skills.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts && tsdown --config-loader unrun --config tsdown.client.config.ts && node scripts/wrap-client.mjs && node scripts/verify-client.mjs",
    "build:host": "tsdown --config-loader unrun --config tsdown.config.ts",
    "build:client": "tsdown --config-loader unrun --config tsdown.client.config.ts && node scripts/wrap-client.mjs && node scripts/verify-client.mjs",
    "lint": "oxlint --config ../../.oxlintrc.json --type-check --deny-warnings src tests",
    "test": "cd ../.. && vitest run"
  }
}
